[flake8]
# Флаги жили только в командной строке (и в документации), поэтому «flake8» без
# них проверял бы по-другому — например, ругался бы на длину 88+ в строках,
# которые весь пакет соблюдает. Здесь они записаны один раз.
max-line-length = 88
extend-ignore = E203,W503

# В тестах импорт идёт после вставки корня репозитория в `sys.path` — без неё
# `simintech_api` не импортируется в неактивированном окружении. Для pytest это
# безопасно (conftest грузится раньше тест-модулей), но формально E402. Прочие
# проверки для тестов остаются включёнными.
per-file-ignores =
    tests/*:E402
    # В примерах те же вставки `sys.path`, а E501 — это ASCII-схемы моделей
    # в docstring: перенос по 88 символам сломал бы рисунок.
    examples/*:E402,E501
